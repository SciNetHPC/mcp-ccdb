# ccdb-mcp configuration
# Copy to .env for local runs.  In production, inject the values from your
# secret manager or orchestration layer.

# CCDB / Allocations API backend.  These are the server's own privileged
# credentials, not the caller's.
ALLOCATIONS_API_HOST=https://allocations.example.org
ALLOCATIONS_API_KEY=

# HTTP transport.
CCDB_MCP_HOST=0.0.0.0
CCDB_MCP_PORT=8081
CCDB_MCP_PATH=/mcp
DNS_REBINDING_PROTECTION=true
# Set this to the public hostname (and port) clients use.
ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# OIDC access-token validation.  Needed when a trusted front end forwards
# each user's access token (for example a chat application).
OIDC_ISSUER_URL=https://idp.example.org
OIDC_AUDIENCE=
# OIDC_REQUIRE_BOUND_OPAQUE=true
# OIDC_ALLOW_JWT_ACCESS_TOKENS=false

# Per-user API tokens from a token-issuer deployment (public MCP clients).
# TOKEN_HMAC_SECRET must be the same secret the issuer and every server
# using these tokens are configured with.
TOKEN_HMAC_SECRET=
SERVICE_ID=ccdb
TOKEN_REVOCATION_PATH=

# Cross-user ("staff") access.  STAFF_GROUPS is compared against group
# claims; STAFF_LIST_PATH is a JSON file with a "staffUsernames" list,
# re-read on a short poll.  An empty STAFF_GROUPS falls back to the built-in
# default, so set it to a group that does not exist to disable the group
# check.  STAFF_LIST_PATH is optional.
STAFF_GROUPS=cc-staff,scinet
STAFF_LIST_PATH=

# Logging: JSON lines on stdout, timestamps in this zone.
LOG_LEVEL=INFO
LOG_TIME_ZONE=America/Toronto
